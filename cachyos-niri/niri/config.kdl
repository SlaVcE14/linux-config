include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"
output "eDP-1" {
    mode "1920x1080@60.001"

    scale 1.0

    transform "normal"
    position x=0 y=340
}
output "HDMI-A-1" {
    mode "1920x1080@60.000"

    scale 1.0

    transform "normal"
    position x=1920 y=0
}
spawn-at-startup "discord"

gestures {
    hot-corners {
        off
    }
}
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "Spotify" {
    open-on-output "HDMI-A-1"
}

switch-events {
    lid-close {
        // Triggers Noctalia's built-in lock screen, then suspends the computer
        spawn "qs -c noctalia-shell ipc call lockScreen lock" "systemctl" "suspend"
    }
}
